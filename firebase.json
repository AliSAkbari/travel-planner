{
  "hosting": {
    "public": "hosting-placeholder",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "function": { "functionId": "api", "region": "us-west1" }
      },
      {
        "source": "/health",
        "function": { "functionId": "api", "region": "us-west1" }
      },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "functions": [
    {
      "source": "backend",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "local.env",
        "*.example",
        "src",
        "test",
        "scripts",
        "coverage"
      ]
    }
  ]
}
