# Copy to .env for local development: cp .env.example .env
# .env is gitignored. In production, set these in the host's dashboard instead.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on (Render sets this automatically).
PORT=3000

# Number of reverse proxies in front of the app, used for Express 'trust proxy'.
# 0 locally (no proxy). On Render, set to the hop count verified on deploy.
TRUST_PROXY_HOPS=0
