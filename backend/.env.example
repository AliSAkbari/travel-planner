# Copy to .env for local development: cp .env.example .env
# .env is gitignored. In production, set these in the host's dashboard instead.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on (Render sets this automatically).
PORT=3000

# Number of reverse proxies in front of the app, used for Express 'trust proxy'.
# 0 locally (no proxy). On Render, set to the hop count verified on deploy.
TRUST_PROXY_HOPS=0

# HS256 signing secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Token lifetime in seconds (3600 = 1 hour).
JWT_EXPIRES_IN_SECONDS=3600

# The single demo user. Credentials are provided with the submission, never committed.
DEMO_USERNAME=demo
# bcrypt hash of the demo password: run `npm run hash-password` and paste the output.
# No quotes needed: Node's .env loader keeps $ characters literally.
DEMO_PASSWORD_HASH=

# Temporary: exposes GET /api/diagnostics/network (still requires a token).
ENABLE_DIAGNOSTICS=false
