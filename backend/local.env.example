# Settings for the local dev server (npm run dev). Copy to local.env (gitignored):
#   cp local.env.example local.env
#
# Deliberately NOT named .env: the Firebase CLI auto-loads backend/.env into the
# deployed function, where PORT is a reserved key and JWT_SECRET/DEMO_PASSWORD_HASH
# must come from Secret Manager instead. Deployed settings: see firebase.env.example.

# development | test | production
NODE_ENV=development

# Port the local HTTP server listens on.
PORT=3000

# Number of reverse proxies in front of the app, used for Express 'trust proxy'.
# 0 locally: there is no proxy in front of the dev server.
TRUST_PROXY_HOPS=0

# HS256 signing secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Token lifetime in seconds (3600 = 1 hour).
JWT_EXPIRES_IN_SECONDS=3600

# The single demo user. Credentials are provided with the submission, never committed.
DEMO_USERNAME=demo
# bcrypt hash of the demo password: run `npm run hash-password` and paste the output.
# No quotes needed: Node's .env loader keeps $ characters literally.
DEMO_PASSWORD_HASH=

# Optional ip2location.io API key. Leave empty to call the API keyless
# (1,000 lookups/day). With a free key: 50,000/month, counted per key.
IP2LOCATION_API_KEY=
