# Non-secret settings for the deployed Firebase function.
# Copy to .env.<your-project-id> (gitignored). The Firebase CLI reads that file
# at deploy time and sets its values as the function's environment variables.
# For the emulators, copy it to .env.local instead.
#
# Do NOT put JWT_SECRET or DEMO_PASSWORD_HASH here: they live in Secret Manager
# (firebase functions:secrets:set). Do NOT set PORT: it is reserved and set by
# the platform.

NODE_ENV=production

# Token lifetime in seconds (3600 = 1 hour).
JWT_EXPIRES_IN_SECONDS=3600

# The demo user's username. Its password hash is a secret.
DEMO_USERNAME=

# Number of reverse proxies in front of the function (Express 'trust proxy').
# Start at 0; set to the hop count measured with the diagnostics endpoint.
TRUST_PROXY_HOPS=0

# Temporary: exposes GET /api/diagnostics/network (still requires a token).
ENABLE_DIAGNOSTICS=false
