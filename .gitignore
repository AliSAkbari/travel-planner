test-results/

# Environment files: real values never enter the repo; only *.example templates are committed.
# local.env        -> backend dev server (npm run dev)
# .env.<projectId> -> non-secret settings deployed with the Firebase function
# .env.local       -> Firebase emulator overrides
# .secret.local    -> Firebase emulator stand-ins for Secret Manager secrets
.env
.env.*
local.env
.secret.local

# Firebase CLI cache
.firebase/

# Claude Code local settings
.claude/

# Logs and OS/editor noise
*.log
.DS_Store
Thumbs.db
